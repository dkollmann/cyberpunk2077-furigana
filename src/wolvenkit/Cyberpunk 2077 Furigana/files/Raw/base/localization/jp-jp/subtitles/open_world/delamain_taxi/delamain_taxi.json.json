  "Data": {
    "Version": 195,
    "BuildVersion": 0,
    "RootChunk": {
      "$type": "JsonResource",
      "cookingPlatform": "PLATFORM_PC",
      "root": {
        "HandleId": "0",
        "Data": {
          "$type": "localizationPersistenceSubtitleEntries",
          "entries": [
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "ご乗車、誠にありがとうございます。目的地をご指定ください",
              "maleVariant": "",
              "stringId": "4880116222525337600"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "承知しました。制限航路に沿って航行いたします",
              "maleVariant": "",
              "stringId": "4880118588565778432"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "今日はこちらで失礼いたします。ご利用いただき、ありがとうございました",
              "maleVariant": "",
              "stringId": "4880119632930697216"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "目的地に到着しました。ご利用ありがとうございました。どうぞ良い一日を",
              "maleVariant": "",
              "stringId": "4880125135505223680"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "“いつも安全、快適なドライブをお約束”――デラマン・サービスへようこそ",
              "maleVariant": "",
              "stringId": "4880162954353209344"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "何か御用でしょうか？",
              "maleVariant": "",
              "stringId": "4880163500183154688"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "デラマン・ネットワークへようこそ",
              "maleVariant": "",
              "stringId": "4880164026014658560"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "では、快適な一日を",
              "maleVariant": "",
              "stringId": "4880167704972914688"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "それでは、ごきげんよう",
              "maleVariant": "",
              "stringId": "4880168144988958720"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "ご利用ありがとうございました",
              "maleVariant": "",
              "stringId": "4880168513450176512"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "目的地に到着しました。申し訳ありませんが、ご確認を",
              "maleVariant": "",
              "stringId": "4880170205667291136"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "デラマンを初めてご利用頂きありがとうございます。何なりとお申し付けください",
              "maleVariant": "",
              "stringId": "4880173435784687628"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "どうも",
              "maleVariant": "",
              "stringId": "4880173620350840832"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "調子はどう？",
              "maleVariant": "調子はどうだ？",
              "stringId": "4880175664352620544"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "よろしく",
              "maleVariant": "",
              "stringId": "4880176533697622016"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "じゃあね",
              "maleVariant": "じゃあな",
              "stringId": "4880179499540312064"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "じゃあ、また",
              "maleVariant": "",
              "stringId": "4880180031612940288"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "またね",
              "maleVariant": "またな",
              "stringId": "4880180419602837504"
            }
          ]
        }
      }
    },
    "EmbeddedFiles": []
  }
}