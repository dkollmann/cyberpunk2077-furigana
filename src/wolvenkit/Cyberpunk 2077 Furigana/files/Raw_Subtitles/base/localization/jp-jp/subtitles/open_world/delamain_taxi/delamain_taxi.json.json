          "entries": [
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "323E7Z^ご乗{じょう}車{しゃ}、誠{まこと}にありがとうございます。目{もく}的{てき}地{ち}をご指{し}定{てい}ください",
              "maleVariant": "",
              "stringId": "4880116222525337600"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "153E7Z^承{しょう}知{ち}しました。制{せい}限{げん}航{こう}路{ろ}に沿{そ}って航{こう}行{こう}いたします",
              "maleVariant": "",
              "stringId": "4880118588565778432"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "3E3E7Z^今{こん}日{にち}はこちらで失{しつ}礼{れい}いたします。ご利{り}用{よう}いただき、ありがとうございました",
              "maleVariant": "",
              "stringId": "4880119632930697216"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "693E7Z^目{もく}的{てき}地{ち}に到{とう}着{ちゃく}しました。ご利{り}用{よう}ありがとうございました。どうぞ良{よ}い一日{ついたち}を",
              "maleVariant": "",
              "stringId": "4880125135505223680"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "CC3E7Z^“いつも安{あん}全{ぜん}、快{かい}適{てき}なドライブをお約{やく}束{そく}”――デラマン・サービスへようこそ",
              "maleVariant": "",
              "stringId": "4880162954353209344"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "E23E7Z^何{なに}か御{ご}用{よう}でしょうか？",
              "maleVariant": "",
              "stringId": "4880163500183154688"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "デラマン・ネットワークへようこそ",
              "maleVariant": "",
              "stringId": "4880164026014658560"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "E33E7Z^では、快{かい}適{てき}な一日{ついたち}を",
              "maleVariant": "",
              "stringId": "4880167704972914688"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "それでは、ごきげんよう",
              "maleVariant": "",
              "stringId": "4880168144988958720"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "203E7Z^ご利{り}用{よう}ありがとうございました",
              "maleVariant": "",
              "stringId": "4880168513450176512"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "203E7Z^目{もく}的{てき}地{ち}に到{とう}着{ちゃく}しました。申{もう}し訳{わけ}ありませんが、ご確{かく}認{にん}を",
              "maleVariant": "",
              "stringId": "4880170205667291136"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "323E700C^デラマンを初{はじ}めてご利{り}用{よう}頂{いただ}きありがとうございます。何{なに}なりとお申{もう}し付{つ}けください",
              "maleVariant": "",
              "stringId": "4880173435784687628"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "どうも",
              "maleVariant": "",
              "stringId": "4880173620350840832"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "133E7Z^調{ちょう}子{し}はどう？",
              "maleVariant": "133E7Z^調{ちょう}子{し}はどうだ？",
              "stringId": "4880175664352620544"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "よろしく",
              "maleVariant": "",
              "stringId": "4880176533697622016"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "じゃあね",
              "maleVariant": "じゃあな",
              "stringId": "4880179499540312064"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "じゃあ、また",
              "maleVariant": "",
              "stringId": "4880180031612940288"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "またね",
              "maleVariant": "またな",
              "stringId": "4880180419602837504"
            }
          ]
        }
      }
